<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>62.0</apiVersion>
    <description>Looks up a Parcel by Parcel ID and returns a tracking summary. Used as an Agentforce action.</description>
    <assignments>
        <name>Set_Found_Output</name>
        <label>Set Found Output</label>
        <locationX>50</locationX>
        <locationY>458</locationY>
        <assignmentItems>
            <assignToReference>Output</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>ParcelSummary</elementReference>
            </value>
        </assignmentItems>
    </assignments>
    <assignments>
        <name>Set_Not_Found_Output</name>
        <label>Set Not Found Output</label>
        <locationX>314</locationX>
        <locationY>458</locationY>
        <assignmentItems>
            <assignToReference>Output</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>No parcel was found for that Parcel ID. Please check the ID (for example P-001) and try again.</stringValue>
            </value>
        </assignmentItems>
    </assignments>
    <decisions>
        <name>Parcel_Found</name>
        <label>Parcel Found?</label>
        <locationX>182</locationX>
        <locationY>350</locationY>
        <defaultConnector>
            <targetReference>Set_Not_Found_Output</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Not Found</defaultConnectorLabel>
        <rules>
            <name>Found</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Parcel_Records</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Found_Output</targetReference>
            </connector>
            <label>Found</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <interviewLabel>Parcel Details {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Parcel Details</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Get_Parcel_Records</name>
        <label>Get Parcel Records</label>
        <locationX>182</locationX>
        <locationY>242</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Parcel_Found</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Parcel_ID__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>ids</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Parcel__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <runInMode>SystemModeWithoutSharing</runInMode>
    <start>
        <locationX>56</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Parcel_Records</targetReference>
        </connector>
    </start>
    <status>Active</status>
    <textTemplates>
        <name>ParcelSummary</name>
        <isViewedAsPlainText>true</isViewedAsPlainText>
        <text>Parcel Tracking Update
Parcel Name: {!Get_Parcel_Records.Name}
Parcel ID: {!Get_Parcel_Records.Parcel_ID__c}
Status: {!Get_Parcel_Records.Status__c}
Weight: {!Get_Parcel_Records.Weight__c}
Estimated Delivery Date: {!Get_Parcel_Records.Estimated_Delivery_Date__c}</text>
    </textTemplates>
    <variables>
        <name>ids</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>Output</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
    </variables>
</Flow>
